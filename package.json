{
  "name": "particle-life-bg",
  "version": "0.3.0",
  "description": "Particle Life (asymmetric attraction) animated canvas background. Zero-dependency core with an optional React component.",
  "author": "elzup",
  "license": "MIT",
  "type": "module",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./react": {
      "types": "./lib/types/react.d.ts",
      "import": "./lib/esm/react.js",
      "require": "./lib/cjs/react.js"
    },
    "./sim": {
      "types": "./lib/types/sim-api.d.ts",
      "import": "./lib/esm/sim-api.js",
      "require": "./lib/cjs/sim-api.js"
    },
    "./element": {
      "types": "./lib/types/element.d.ts",
      "import": "./lib/esm/element.js",
      "require": "./lib/cjs/element.js"
    }
  },
  "repository": "elzup/particle-life-bg",
  "bugs": {
    "url": "https://github.com/elzup/particle-life-bg/issues"
  },
  "homepage": "https://elzup.github.io/particle-life-bg/",
  "keywords": [
    "particle-life",
    "background",
    "canvas",
    "animation",
    "artificial-life",
    "react",
    "web-components",
    "custom-element"
  ],
  "scripts": {
    "clean": "rm -rf lib",
    "build": "pnpm clean && pnpm build:cjs && pnpm build:esm && pnpm build:types",
    "build:cjs": "tsc --module commonjs --declaration false --outDir lib/cjs && echo '{\"type\":\"commonjs\"}' > lib/cjs/package.json",
    "build:esm": "tsc --declaration false --outDir lib/esm",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir lib/types",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:cov": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/**/*.test.ts\"",
    "prepublishOnly": "pnpm build && pnpm test",
    "build:wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path wasm/Cargo.toml && RUSTFLAGS='-C target-feature=+simd128' cargo build --release --target wasm32-unknown-unknown --manifest-path wasm/Cargo.toml --target-dir wasm/target-simd && mkdir -p lib/wasm && cp wasm/target/wasm32-unknown-unknown/release/particle_life_sim.wasm lib/wasm/sim.wasm && cp wasm/target-simd/wasm32-unknown-unknown/release/particle_life_sim.wasm lib/wasm/sim-simd.wasm && node scripts/embed-wasm.ts",
    "bench": "node scripts/bench.ts",
    "size": "node scripts/size.ts",
    "size:check": "node scripts/size.ts --check"
  },
  "files": [
    "lib/",
    "!lib/wasm/"
  ],
  "sideEffects": [
    "./lib/esm/element.js",
    "./lib/cjs/element.js"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.15.0",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
